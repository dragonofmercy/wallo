{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallo",
  "version": "0.1.0",
  "identifier": "com.wallo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "create": false, "visible": false, "title": "Wallo", "width": 920, "height": 730, "resizable": false, "maximizable": false, "theme": "Dark", "backgroundColor": "#0a1628" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
