{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallo",
  "identifier": "com.wallo.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "create": false, "visible": false, "title": "Wallo", "width": 920, "height": 730, "resizable": false, "maximizable": false, "theme": "Dark", "backgroundColor": "#0a1628" }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2RTM5REE0MUVENTQ2NDMKUldSRFJ0VWVwSjNqVmx4MzVqc3FzTEFtZzFRWEh2N0ZBNWs0VnhZeUh1V1E1MHc2Uzg5T0JwdjYK",
      "endpoints": ["https://github.com/dragonofmercy/wallo/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
